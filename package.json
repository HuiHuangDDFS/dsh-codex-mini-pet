{
  "name": "dsh-hide-pet",
  "version": "1.2.5",
  "description": "DeepSeek Harness 的动画宠物伙伴：鲸鱼娘与智域，支持 Codex v1/v2 图集。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "dsh-hide-pet": "./src/cli.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src",
    "native",
    "assets",
    "skills",
    "locale",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "preview": "node src/preview.mjs",
    "test:native": "node scripts/verify-native-windows.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@jsquash/webp": "1.5",
    "fflate": "^0.8.2",
    "image-size": "^2.0.4",
    "pngjs": "^7.0.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HuiHuangDDFS/dsh-hide-pet.git"
  },
  "license": "MIT"
}
